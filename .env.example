# FP-Agent (They) 环境变量配置
# 复制为 .env 并填入你的实际值

# ===== LLM 模型供应商 =====
# 选择一个：openrouter / openai / nous / custom
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
NOUS_API_KEY=your_nous_api_key_here

# 模型名称（可选）
LLM_MODEL=anthropic/claude-3.5-sonnet
# 备选：anthropic/claude-3-opus, gpt-4o, nous/hermes-3

# ===== 数据库 =====
POSTGRES_DB=fp_db
POSTGRES_USER=user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

QDRANT_HOST=localhost
QDRANT_PORT=8645

# ===== 外部 API 集成 =====
# Google Calendar / Gmail
GOOGLE_CALENDAR_API_KEY=
GMAIL_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Calendar
APPLE_CALENDAR_API_KEY=

# 国内服务
WECHAT_API_KEY=
DOUBAN_API_KEY=
ALIPAY_API_KEY=

# ===== Agent 配置 =====
# Hermes Agent 集成
HERMES_MODEL=hermes_agent
HERMES_SKILLS_PATH=/Users/ping/.claude/skills/hermes-agent

# 主动提醒
AUTO_REMINDER=true
REMINDER_TIME_MORNING=08:00
REMINDER_TIME_EVENING=20:00

# ===== 部署 =====
DOCKER_COMPOSE_FILE=docker-compose.yml
CLOUD_DEPLOY=false

# ===== 可选：日志级别 =====
LOG_LEVEL=INFO