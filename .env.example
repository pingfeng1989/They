# ============================================================
# They — Life Management Agent (built on Hermes Agent)
# Copy to `.env` and fill in your actual values.
# Secrets only — behavioral config lives in `config.yaml`
# (and skill config keys under `skills.config.<key>`).
# ============================================================

# -------- Hermes Runtime --------
HERMES_HOME=~/.hermes
HERMES_LLM_PROVIDER=openrouter
HERMES_MODEL=anthropic/claude-3.5-sonnet

# -------- Secrets --------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
NOUS_API_KEY=your_nous_api_key_here

# Google (Calendar / Gmail)
GOOGLE_CALENDAR_API_KEY=
GMAIL_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple (Calendar / Reminders)
APPLE_CALENDAR_API_KEY=

# Domestic services
WECHAT_API_KEY=
ALIPAY_API_KEY=

# -------- Skills config (clearly delimited block) --------
# Values here map to skills.config.<key>, injected at skill load.
# Skills declared in this block: budget-tracking, expense-tracking,
# shopping-comparison, lifestyle-reminder.
skills.config.budgeting.enabled=true
skills.config.expense_tracking.enabled=true
skills.config.shopping_comparison.enabled=true
skills.config.lifestyle_reminder.enabled=true
skills.config.lifestyle_reminder.morning_time=08:00
skills.config.lifestyle_reminder.evening_time=20:00

# -------- Deployment --------
CLOUD_DEPLOY=false
LOG_LEVEL=INFO